  "pages": [
    {
      "name": "2861c682",
      "displayName": "Front page",
      "layout": [
        {
          "widget": {
            "name": "df798cb7",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "e7718963",
                  "fields": [
                    {
                      "name": "Date",
                      "expression": "`Date`"
                    },
                    {
                      "name": "avg(Volume)",
                      "expression": "AVG(`Volume`)"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "IN_RANGE(`Date`, PARSE_RELATIVE_DATE('now-3M/M', 'FLOOR'), PARSE_RELATIVE_DATE('now/M', 'CEIL'))"
                    },
                    {
                      "expression": "`Ticker` IN ('SPY')"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "title": "Closing Price Trend",
                "showTitle": true
              },
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "Date",
                  "axis": {
                    "hideTitle": false
                  },
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "avg(Volume)",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              }
            }
          },
          "position": {
            "x": 1,
            "y": 2,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "70943d30",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "e7718963",
                  "fields": [
                    {
                      "name": "daily(Date)",
                      "expression": "DATE_TRUNC(\"DAY\", `Date`)"
                    },
                    {
                      "name": "sum(Volume)",
                      "expression": "SUM(`Volume`)"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "`volatility_7d` IN (`volatility_7d`) OR TRUE"
                    },
                    {
                      "expression": "`Ticker` IN ('SPY')"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "DESC",
                      "expression": "DATE_TRUNC(\"DAY\", `Date`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "showDescription": true,
                "description": "Recent Trading Volume SPY:"
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(Volume)"
                },
                "period": {
                  "fieldName": "daily(Date)"
                }
              }
            }
          },
          "position": {
            "x": 1,
            "y": 0,
            "width": 2,
            "height": 2
